#!/usr/bin/env bash
# phone-recover — 深度恢复无线连接
#
# 跟 phone-autoconnect 的分工：
#   phone-autoconnect  后台服务用，静默、有节流、只做低成本尝试
#   phone-recover      用户手动触发，无节流、会扫端口、会把端口固定回 5555
#
# 适用场景：
#   - 手机重启后 `service.adb.tcp.port` 被重置（5555 没了）
#   - 手机 Wi-Fi 重连、IP 变了
#   - 「无线调试」开了但连不上（端口对不上）
#
# 流程（按代价从低到高）：
#   0. 确认 IP 可达
#   1. 试固定端口 5555
#   2. 试 wireless.env 里记录的端口
#   3. 扫描 32768-60999，逐个 adb connect 验证
#   4. 连上后执行 adb tcpip 5555，把端口固定回去（--secure 时跳过，保留 TLS 加密）
#   5. 更新 wireless.env 并重启同步服务
#
# 用法：
#   phone recover             默认：固定回 5555（方便，流量明文但有密钥认证）
#   phone recover --secure    不固定端口，保持无线调试的 TLS 加密（端口随机）
set -uo pipefail

# 默认把端口固定回 5555（方便，但明文）。--secure 则不固定，
# 保持「无线调试」的 TLS 加密模式（代价：端口随机，下次要重新扫）。
FIX_PORT=1
for a in "$@"; do
  case "$a" in
    --secure|--no-fix-port) FIX_PORT=0 ;;
  esac
done

_pick_bin() {
  for c in "$@"; do
    [ -n "$c" ] && [ -x "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}
ADB="$(_pick_bin "${ADB:-}" "$HOME/.local/bin/adb" "$(command -v adb 2>/dev/null)")" || ADB="adb"
DIR="$HOME/.local/opt/phonesync"
STATE="$DIR/wireless.env"

say()  { printf '  %s\n' "$*"; }
ok()   { printf '  \033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[1;33m[!]\033[0m %s\n' "$*"; }
die()  { printf '  \033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }

command -v "$ADB" >/dev/null 2>&1 || [ -x "$ADB" ] || die "找不到 adb"

# ── 收集候选地址 ──
# Tailscale 优先：手机的 tailnet IP 固定不变，比校园网 DHCP 地址可靠得多。
# 手机换网络（Wi-Fi ↔ 流量）时校园网 IP 会失效，但 tailnet IP 始终可用。
_ts_ip() {
  command -v tailscale >/dev/null 2>&1 || return 1
  tailscale status 2>/dev/null | awk '$4=="android"{print $1; exit}'
}
TS_IP="$(_ts_ip 2>/dev/null || true)"
LAN_IP="$(sed -n 's/^WIRELESS_IP=//p' "$STATE" 2>/dev/null | head -1)"
PORT="$(sed -n 's/^WIRELESS_PORT=//p' "$STATE" 2>/dev/null | head -1)"

CAND_IPS=()
[ -n "$TS_IP" ] && CAND_IPS+=("$TS_IP")
if [ -n "$LAN_IP" ] && [ "$LAN_IP" != "$TS_IP" ]; then CAND_IPS+=("$LAN_IP"); fi
[ ${#CAND_IPS[@]} -gt 0 ] || die "没记录过无线地址，也没在 Tailscale 上发现手机。
    先配对：phone pair <地址> <配对码>　或确认手机 Tailscale 在线"
IP="${CAND_IPS[0]}"

device_ok() { "$ADB" devices 2>/dev/null | awk 'NR>1 && $2=="device"{print $1}' | grep -qx "$1"; }

try_connect() {   # $1=ip:port
  "$ADB" connect "$1" >/dev/null 2>&1
  sleep 1
  if device_ok "$1"; then
    return 0
  fi
  # 失败就把 offline 条目清掉，免得 adb devices 里堆一堆垃圾
  "$ADB" disconnect "$1" >/dev/null 2>&1
  return 1
}

record() {        # $1=ip:port
  printf 'WIRELESS_IP=%s\nWIRELESS_PORT=%s\n' "${1%:*}" "${1##*:}" > "$STATE"
  ok "已记录 $1"
}

echo "phone recover — 深度恢复无线连接"
say "候选地址: ${CAND_IPS[*]}   (记录端口: ${PORT:-无})"

FOUND=""

# ── 阶段 1+2：逐个候选 IP 试固定端口和记录端口 ──
for ip in "${CAND_IPS[@]}"; do
  [ -n "$FOUND" ] && break
  say "① $ip 试固定端口 5555 ..."
  if try_connect "$ip:5555"; then FOUND="$ip:5555"; ok "5555 可用"; break; fi
  if [ -n "$PORT" ] && [ "$PORT" != "5555" ]; then
    say "② $ip 试记录端口 $PORT ..."
    if try_connect "$ip:$PORT"; then FOUND="$ip:$PORT"; ok "记录端口可用"; break; fi
  fi
done

# ── 阶段 3：扫描（对每个候选 IP）──
if [ -z "$FOUND" ]; then
 for ip in "${CAND_IPS[@]}"; do
  [ -n "$FOUND" ] && break
  say "③ 扫描 $ip 的 32768-60999（约 30~90 秒，请稍等）..."
  CANDIDATES="$(python3 - "$ip" <<'PY'
import asyncio, sys, time

ip = sys.argv[1]
LO, HI, CONC = 32768, 60999, 800

async def probe(port, sem):
    async with sem:
        try:
            _r, w = await asyncio.wait_for(asyncio.open_connection(ip, port), 0.7)
            w.close()
            return port
        except Exception:
            return None

async def main():
    t0 = time.time()
    sem = asyncio.Semaphore(CONC)
    res = await asyncio.gather(*[probe(p, sem) for p in range(LO, HI + 1)])
    ports = [p for p in res if p]
    sys.stderr.write(f"      扫完，耗时 {time.time()-t0:.1f}s\n")
    for p in ports:
        print(p)

try:
    asyncio.run(main())
except KeyboardInterrupt:
    pass
PY
)"
  N=$(printf '%s\n' "$CANDIDATES" | grep -c '[0-9]' 2>/dev/null || echo 0)
  if [ "$N" -eq 0 ]; then
    say "    开放端口 0 个"
  else
    say "    开放端口 $N 个，逐个验证是不是 adb（校园网代理会有假阳性）..."
    i=0
    for p in $CANDIDATES; do
      i=$((i + 1))
      printf '      [%d/%d] 试 %s ... ' "$i" "$N" "$p"
      if try_connect "$ip:$p"; then
        printf '✓\n'; ok "adb 端口: $p"; FOUND="$ip:$p"; break
      fi
      printf '✗\n'
    done
  fi
 done
fi

# ── 失败 ──
if [ -z "$FOUND" ]; then
  echo
  warn "没找到可用的 adb 端口。"
  warn "最可靠的办法是直接看手机屏幕："
  warn "  设置 → 系统设置 → 开发者选项 → 无线调试 → 「IP 地址和端口」"
  warn "  然后： phone use <那个地址>"
  echo
  warn "如果无线调试界面显示的端口也连不上，可能是 adbd 卡在传统 TCP 模式："
  warn "  插一次 USB → phone wireless（切回 5555）→ 拔线"
  exit 1
fi

# ── 阶段 4：把端口固定回 5555 ──
if [ "$FIX_PORT" = "1" ] && [ "${FOUND##*:}" != "5555" ]; then
  say "④ 把端口固定回 5555（以后就不用每次找了；想保留 TLS 加密请用 phone recover --secure）..."
  "$ADB" -s "$FOUND" tcpip 5555 >/dev/null 2>&1
  sleep 3
  if try_connect "${FOUND%:*}:5555"; then
    FOUND="${FOUND%:*}:5555"; ok "已固定到 5555"
  else
    warn "固定失败（无线连接可能不支持重设端口），继续用 ${FOUND##*:}"
  fi
fi

if [ "$FIX_PORT" = "0" ]; then
  if [ "${FOUND##*:}" = "5555" ]; then
    echo
    warn "注意：当前用的是 tcpip 5555（明文）模式，--secure 不会自动帮你切。"
    warn "想要 TLS 加密，需要两步："
    warn "  1) phone usb              关闭 5555，让无线调试的 TLS 端口恢复监听"
    warn "  2) phone recover --secure 重新扫描并连 TLS 端口"
  else
    ok "保持无线调试的 TLS 加密模式（端口 ${FOUND##*:}）"
    ok "下次端口变了，再跑一次 phone recover --secure"
  fi
fi

record "$FOUND"

# ── 阶段 5：重启服务 ──
say "⑤ 重启同步服务 ..."
systemctl --user restart phone-clip.service phone-sync.service phone-push.service 2>/dev/null
sleep 6
for s in phone-clip phone-sync phone-push; do
  printf '    %-12s %s\n' "$s" "$(systemctl --user is-active "$s.service" 2>/dev/null)"
done

echo
ok "恢复完成：$(sed -n 's/^WIRELESS_IP=//p' "$STATE"):$(sed -n 's/^WIRELESS_PORT=//p' "$STATE")"
